#lang racket/base

(define (my-length xs)
  (let loop ((rest xs) (n 0))
    (if (null? rest) n (loop (cdr rest) (+ n 1)))))
(define (my-reverse xs)
  (let loop ((rest xs) (out '()))
    (if (null? rest) out (loop (cdr rest) (cons (car rest) out)))))
(define (my-map f xs)
  (let loop ((rest xs) (out '()))
    (if (null? rest) (my-reverse out)
        (loop (cdr rest) (cons (f (car rest)) out)))))
(define (make-inserter x len-ok?)
  (letrec ((walk (lambda (lst)
                   (let ((transformed
                          (my-map (lambda (item)
                                    (if (or (pair? item) (null? item))
                                        (walk item) item))
                                  lst)))
                     (if (len-ok? (my-length lst))
                         (cons x transformed) transformed)))))
    walk))
(define (insert-if-short x lst n)
  ((make-inserter x (lambda (len) (< len n))) lst))
(define (print-insert-result)
  (let* ((x (read)) (lst (read)) (n (read)))
    (display (insert-if-short x lst n)) (newline)))
